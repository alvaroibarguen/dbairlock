# dbairlock build entry points. Requires Go and, for the dashboard, pnpm.
#
# Embedding the dashboard
# -----------------------
# The Go binary embeds internal/webui/dist (see internal/webui/webui.go).
# That directory is committed containing only a .keep file; everything else
# in it is gitignored. `make build` builds web/ with Vite and copies web/dist
# into it before compiling, so release binaries carry the dashboard. A plain
# `go build ./...` still works and serves a short "not built" page instead.
#
# Every web step is skipped with a notice when web/package.json is absent,
# so the Go side builds, tests and lints on its own.

SHELL := bash
.SHELLFLAGS := -eu -o pipefail -c
.DEFAULT_GOAL := build

BIN        := bin/dbairlock
WEB        := web
WEB_DIST   := internal/webui/dist
HAS_WEB    := $(wildcard $(WEB)/package.json)
VERSION    ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
LDFLAGS    := -s -w -X main.version=$(VERSION)
DEV_LISTEN ?= 127.0.0.1:8080
DEV_DATA   ?= ./data
# Go code generated by `make generate`: oapi-codegen output and one sqlc
# package per module (see sqlc.yaml). Add each new sqlc package here.
GO_GEN     := internal/httpapi/gen internal/audit/auditdb internal/secrets/secretsdb internal/settings/settingsdb \
              internal/setup/setupdb internal/identity/identitydb internal/targets/targetsdb \
              internal/changes/changesdb

.PHONY: dev build web-build web-sync go-build generate generate-check test lint e2e clean

## dev: run the Go server (--dev) and the Vite dev server together; Ctrl-C stops both.
dev:
ifeq ($(HAS_WEB),)
	go run ./cmd/dbairlock serve --dev --data-dir $(DEV_DATA) --listen $(DEV_LISTEN)
else
	trap 'kill 0' EXIT INT TERM; \
	go run ./cmd/dbairlock serve --dev --data-dir $(DEV_DATA) --listen $(DEV_LISTEN) & \
	pnpm --dir $(WEB) dev & \
	wait -n
endif

## build: build the dashboard, embed it, and build one binary at bin/dbairlock.
build: web-build web-sync go-build

web-build:
ifeq ($(HAS_WEB),)
	@echo "web/package.json not found; skipping dashboard build"
else
	pnpm --dir $(WEB) install --frozen-lockfile
	pnpm --dir $(WEB) build
endif

# Replace everything in internal/webui/dist except the committed .keep.
web-sync:
ifeq ($(HAS_WEB),)
	@echo "web/package.json not found; embedding the placeholder only"
else
	find $(WEB_DIST) -mindepth 1 ! -name .keep -exec rm -rf {} +
	cp -R $(WEB)/dist/. $(WEB_DIST)/
endif

go-build:
	CGO_ENABLED=1 go build -trimpath -ldflags "$(LDFLAGS)" -o $(BIN) ./cmd/dbairlock

## generate: regenerate code: sqlc query packages, and from api/openapi.yaml the Go server stubs and TypeScript types.
generate:
	go tool sqlc generate
	go generate ./internal/httpapi/gen
ifeq ($(HAS_WEB),)
	@echo "web/package.json not found; skipping TypeScript generation"
else
	pnpm --dir $(WEB) exec openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts
endif

## generate-check: fail if generated files are out of date (for CI).
generate-check: generate
	@git diff --exit-code -- $(GO_GEN) $(WEB)/src/api/schema.d.ts || \
		(echo "generated files are out of date; run make generate and commit" >&2; exit 1)
	@test -z "$$(git status --porcelain -- $(GO_GEN) $(WEB)/src/api)" || \
		(echo "untracked generated files; run make generate and commit" >&2; git status --porcelain -- $(GO_GEN) $(WEB)/src/api >&2; exit 1)

## test: Go tests, then dashboard unit tests.
test:
	go test ./...
ifneq ($(HAS_WEB),)
	pnpm --dir $(WEB) test
endif

## lint: golangci-lint (includes the depguard import rules), then dashboard lint.
lint:
	go tool golangci-lint run ./...
ifneq ($(HAS_WEB),)
	pnpm --dir $(WEB) lint
endif

## e2e: build the binary, then run the Playwright suite against it.
e2e: build
ifeq ($(HAS_WEB),)
	@echo "web/package.json not found; no end-to-end tests to run" >&2; exit 1
else
	pnpm --dir $(WEB) e2e
endif

clean:
	rm -rf bin $(WEB)/dist
	find $(WEB_DIST) -mindepth 1 ! -name .keep -exec rm -rf {} +
